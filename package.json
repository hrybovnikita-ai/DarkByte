{
  "name": "necrobyte",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-generate.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:migrate": "node scripts/db-migrate.mjs dev",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "node scripts/prisma-generate.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "db:deploy": "node scripts/db-migrate.mjs deploy"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@clerk/nextjs": "^7.10.10",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@prisma/client": "6.19.3",
    "@upstash/ratelimit": "^2.2.2",
    "@upstash/redis": "^1.41.1",
    "axios": "^1.21.1",
    "bcryptjs": "^3.0.3",
    "gsap": "^3.15.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.80.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "phaser": "^4.2.1",
    "pixi.js": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^23.2.0",
    "svix": "^2.11.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^6.4.6",
    "vitest": "^5.1.2"
  }
