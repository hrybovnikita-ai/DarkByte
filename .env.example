# PostgreSQL (required for API persistence)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/darkbyte?schema=public"

# Optional separate database for destructive integration tests
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/darkbyte_test?schema=public"

# ---- Authentication provider ----
# authjs (legacy) | clerk (recommended). Only one runs at a time.
AUTH_PROVIDER="authjs"
NEXT_PUBLIC_AUTH_PROVIDER="authjs"

# Clerk (when AUTH_PROVIDER=clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/chat"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/chat"

# Auth.js (when AUTH_PROVIDER=authjs)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Transactional email via Resend (Auth.js verification / password reset)
RESEND_API_KEY=""
AUTH_EMAIL_FROM="DarkByte <onboarding@yourdomain.com>"

# Optional: grant ADMIN on first sync with this email (Clerk or Auth.js)
DARKBYTE_BOOTSTRAP_ADMIN_EMAIL=""

# Upstash Redis (optional — distributed rate limits + cache isolation)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# API
API_MAX_BODY_BYTES="1048576"
API_RATE_LIMIT_WINDOW_MS="60000"
API_RATE_LIMIT_MAX="120"
API_RATE_LIMIT_CHAT_STREAM_MAX="45"

# Billing — Stripe TEST MODE only (keys must start with sk_test_ / pk_test_)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# JSON map of sandbox Price IDs for subscription plans (see docs/stripe-sandbox.md)
STRIPE_PRICE_IDS="{\"starter_month\":\"price_xxx\",\"starter_year\":\"price_xxx\",\"pro_month\":\"price_xxx\",\"pro_year\":\"price_xxx\",\"ultimate_month\":\"price_xxx\",\"ultimate_year\":\"price_xxx\"}"
CREDITS_APP_URL="http://localhost:3000"
# Subscription receipt emails (falls back to AUTH_EMAIL_FROM)
BILLING_FROM_EMAIL="DarkByte Billing <billing@yourdomain.com>"

# Direct Neon connection for migrations; keep DATABASE_URL pooled for the app.
DATABASE_URL_UNPOOLED=""

# AI Chat providers (server-side only)
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
SAMBANOVA_API_KEY=""
COHERE_API_KEY=""
NVIDIA_NIM_API_KEY=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# Development only — POST /api/dev/grant-credits with header x-dev-credits-secret
DEV_CREDITS_SECRET=""

# AI memory (local sentence-transformers via Python)
# pip install -r python/requirements-memory.txt
# MEMORY_PYTHON="python"
# MEMORY_DISABLE_PYTHON=1