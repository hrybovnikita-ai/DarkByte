# PostgreSQL (required for API persistence and Auth.js)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/darkbyte?schema=public"

# Optional separate database for destructive integration tests
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/darkbyte_test?schema=public"

# Auth.js — use your existing AUTH_SECRET (do not commit the real value)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Transactional email via Resend (required for verification + password reset emails)
RESEND_API_KEY=""
AUTH_EMAIL_FROM="DarkByte <onboarding@yourdomain.com>"

# Optional: grant ADMIN role on first registration/login with this email
DARKBYTE_BOOTSTRAP_ADMIN_EMAIL=""

# API
API_MAX_BODY_BYTES="1048576"
API_RATE_LIMIT_WINDOW_MS="60000"
API_RATE_LIMIT_MAX="120"
# Credit purchases (Stripe TEST MODE only; never use sk_live_ keys)
# Keys: https://dashboard.stripe.com/test/apikeys (keep sk_ on the server only)
STRIPE_SECRET_KEY=""
# Optional for future Stripe.js; server-side Checkout redirect does not need this in the app
STRIPE_PUBLISHABLE_KEY=""
# From: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""
# Trusted origin for checkout redirects and CSRF checks (must match the browser URL)
CREDITS_APP_URL="http://localhost:3000"

# Direct Neon connection for migration commands; keep DATABASE_URL pooled for the app.
# Optional: if omitted, migration scripts use DATABASE_URL.
DATABASE_URL_UNPOOLED=""

# AI Chat providers (server-side only — never expose in client code or git)
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
SAMBANOVA_API_KEY=""
COHERE_API_KEY=""
NVIDIA_NIM_API_KEY=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
# Development only — POST /api/dev/grant-credits with header x-dev-credits-secret
DEV_CREDITS_SECRET=""

# AI memory (local sentence-transformers via Python)
# pip install -r python/requirements-memory.txt
# MEMORY_PYTHON="python"
# MEMORY_DISABLE_PYTHON=1  # forces deterministic TS fallback embeddings (tests/CI)
