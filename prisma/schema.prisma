generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FavoriteTargetType {
  WORLD
  MONSTER
  STORY
  GAME
  SECRET_FILE
  PIXEL_PROJECT
}

model User {
  id            String    @id @default(cuid())
  clerkId       String?   @unique
  firebaseUid   String?   @unique
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  creditAccount    CreditAccount?
  creditPurchases  CreditPurchase[]
  creditTransactions CreditTransaction[]

  accounts         Account[]
  sessions         Session[]
  favorites          Favorite[]
  pixelProjects      PixelProject[]
  userAchievements   UserAchievement[]
  conversations        Conversation[]
  messageFeedbacks     MessageFeedback[]
  conversationShares   ConversationShare[]
  memoryProfile        UserMemoryProfile?
  preferences          UserPreference[]
  memoryEntries        MemoryEntry[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model World {
  id              String        @id @default(cuid())
  slug            String        @unique
  code            String        @unique
  title           String
  category        String
  headline        String
  description     String        @db.Text
  longDescription String        @db.Text
  buttonLabel     String
  routePath       String
  sceneId         String
  themePrimary    String
  themeSecondary  String
  themeAccent     String
  themeGlow       String
  atmosphereClass String
  imageUrl        String?
  status          PublishStatus @default(PUBLISHED)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  monsters Monster[]
  stories  Story[]
  games    Game[]

  @@index([status, sortOrder])
}

model Monster {
  id          String        @id @default(cuid())
  externalId  String?       @unique
  name        String
  threat      String
  description String        @db.Text
  icon        String?
  worldId     String?
  world       World?        @relation(fields: [worldId], references: [id], onDelete: SetNull)
  status      PublishStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([worldId])
  @@index([name])
}

model Story {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  summary     String        @db.Text
  body        String        @db.Text
  worldId     String?
  world       World?        @relation(fields: [worldId], references: [id], onDelete: SetNull)
  status      PublishStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([worldId])
}

model Game {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  genre       String
  description String        @db.Text
  playable    Boolean       @default(false)
  worldId     String?
  world       World?        @relation(fields: [worldId], references: [id], onDelete: SetNull)
  status      PublishStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([playable])
}

model SecretFile {
  id           String        @id @default(cuid())
  fileCode     String        @unique
  title        String
  classification String
  content      String        @db.Text
  status       PublishStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
}

model PixelProject {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?       @db.Text
  dataJson    Json          @default("{}")
  status      PublishStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

model Favorite {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType   FavoriteTargetType
  targetId     String
  createdAt    DateTime           @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId])
}

model Achievement {
  id          String        @id @default(cuid())
  code        String        @unique
  title       String
  description String        @db.Text
  points      Int           @default(0)
  status      PublishStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  userAchievements UserAchievement[]

  @@index([status])
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  modelId   String    @default("gemini-3.8-flash")
  branchedFromId        String?
  branchedFromMessageId String?
  parentConversation    Conversation?  @relation("ConversationBranch", fields: [branchedFromId], references: [id], onDelete: SetNull)
  childBranches         Conversation[] @relation("ConversationBranch")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages      Message[]
  conversationMemory ConversationMemory?
  shares        ConversationShare[]

  @@index([userId])
  @@index([userId, updatedAt])
  @@index([branchedFromId])
}

enum MemoryKind {
  FACT
  PREFERENCE
  EPISODE
}

model UserMemoryProfile {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  narrative String?  @db.Text
  updatedAt DateTime @updatedAt
}

model UserPreference {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key                  String
  value                String   @db.Text
  confidence           Float    @default(0.75)
  sourceConversationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

model ConversationMemory {
  conversationId String       @id
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  summary        String?      @db.Text
  messageCount   Int          @default(0)
  updatedAt      DateTime     @updatedAt
}

model MemoryEntry {
  id                   String     @id @default(cuid())
  userId               String
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind                 MemoryKind
  content              String     @db.Text
  contentHash          String
  importance           Float      @default(0.5)
  embedding            Json?
  sourceConversationId String?
  sourceMessageId      String?
  lastAccessedAt       DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([userId])
  @@index([userId, kind])
  @@index([userId, contentHash])
  @@index([userId, importance])
}

enum MessageFeedbackRating {
  GOOD
  BAD
}

model MessageFeedback {
  id        String                @id @default(cuid())
  messageId String
  message   Message               @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    MessageFeedbackRating
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([messageId, userId])
  @@index([userId])
  @@index([messageId])
}

model ConversationShare {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  token          String       @unique
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  revokedAt      DateTime?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([createdById])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String       @db.Text
  modelId        String?
  createdAt      DateTime     @default(now())
  feedbacks      MessageFeedback[]

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

model Company {
  id                String        @id @default(cuid())
  slug              String        @unique
  name              String
  logo              String
  website           String
  description       String        @db.Text
  category          String
  accentColor       String
  accentPalette     Json
  integrationStatus String        @default("INSPIRATION_ONLY")
  sortOrder         Int           @default(0)
  status            PublishStatus @default(PUBLISHED)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, sortOrder])
  @@index([category])
}
model CreditAccount {
  userId    String   @id
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model CreditPurchase {
  id              String   @id @default(cuid())
  userId          String
  requestKey      String
  planId          String
  amountCents     Int
  credits         Int
  currency        String   @default("usd")
  stripeSessionId String?  @unique
  createdAt       DateTime @default(now())
  fulfilledAt     DateTime?
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  transaction     CreditTransaction?

  @@unique([userId, requestKey])
  @@index([userId, createdAt])
}

enum CreditTransactionKind {
  PURCHASE
  SPEND
  BONUS
}

model CreditTransaction {
  id                    String   @id @default(cuid())
  userId                String
  amount                Int
  kind                  CreditTransactionKind
  description           String
  idempotencyKey        String   @unique
  purchaseId            String?  @unique
  stripeSessionId       String?  @unique
  stripePaymentIntentId String?  @unique
  stripeEventId         String?  @unique
  createdAt             DateTime @default(now())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  purchase              CreditPurchase? @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt, id])
}
